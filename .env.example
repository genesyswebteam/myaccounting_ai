# ---- Database ----
# Koneksi ADMIN — hanya untuk migrasi & seed. Superuser, menembus RLS.
DATABASE_URL=postgresql://interacc:interacc@localhost:5432/interacc

# Koneksi RUNTIME — dipakai aplikasi. NOSUPERUSER, tunduk pada RLS.
# Jangan pernah menyamakan ini dengan DATABASE_URL.
DATABASE_APP_URL=postgresql://interacc_app:interacc_app@localhost:5432/interacc

# ---- Auth ----
# stub  = mode dev, token palsu diterima (belum butuh kredensial Azure)
# entra = verifikasi JWT beneran ke Microsoft
AUTH_MODE=stub

# Diisi kalau AUTH_MODE=entra
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_ISSUER=

# ---- App ----
# Dipisah per-app: PORT yang generik akan dibaca Next.js juga.
API_PORT=4000
# Port web dikunci di apps/web/package.json
NODE_ENV=development
