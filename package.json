{
  "name": "interacc",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @interacc/db run generate",
    "db:migrate": "pnpm --filter @interacc/db run migrate",
    "db:seed": "pnpm --filter @interacc/db run seed",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:demo-rls": "pnpm --filter @interacc/db run demo-rls"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
